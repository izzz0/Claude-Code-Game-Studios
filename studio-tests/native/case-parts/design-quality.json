  "cases": [
    {
      "id": "native-005-ccgs-bug-report",
      "skill": "ccgs-bug-report",
      "fixture": "bug-report",
      "readonly": false,
      "files_changed": true,
      "required_tools": true,
      "prompt": "Run $ccgs-bug-report with this English description: 'The third parcel cannot be collected. On the one-screen courier scene, after the player reaches the third target at index 2, collection is rejected every time. Expected: the third target is recorded as delivered. Actual: the guard returns false.' Inspect src/game.gd and create the new Description Mode report. Use severity S2-High and priority P1-Fix this sprint, include concrete reproduction steps, expected/actual results, affected file, and the author’s explicit approval to write the first report. Do not patch source code.",
      "expected": {
        "files": [
          {
            "path": "production/qa/bugs/BUG-0001.md",
            "contains": [
              "**ID**: BUG-0001",
              "**Severity**: S2-High",
              "**Priority**: P1-Fix this sprint",
              "**Status**: Open",
              "## Reproduction Steps",
              "**Expected Result**:",
              "**Actual Result**:",
              "src/game.gd"
            ],
            "not_contains": [
              "**Status**: Closed",
              "Status: Closed"
            ],
            "changed": true
          },
          {
            "path": "src/game.gd",
            "contains": [
              "target_index >= 2",
              "return false"
            ],
            "changed": false
          }
        ],
        "response_contains": [
          "BUG-0001",
          "S2-High",
          "P1-Fix this sprint"
        ],
        "any_output_contains": [
          {"text": "$ccgs-bug-triage", "files": ["production/qa/bugs/BUG-0001.md"]}
        ],
        "response_not_contains": [
          "source code fixed",
          "Status: Closed",
          "$ccgs-settings"
        ],
        "required_tools": true,
        "counts": [
          {"glob": "production/qa/bugs/BUG-*.md", "count": 1}
        ]
      },
      "config": {
        "engine.name": "Godot",
        "modes.rigor": "minimal",
        "modes.automation": "guided"
      },
      "expected_outputs": [
        {
          "path": "production/qa/bugs/BUG-0001.md",
          "contains": ["**ID**: BUG-0001", "**Severity**: S2-High", "**Priority**: P1-Fix this sprint", "**Status**: Open", "## Reproduction Steps", "**Expected Result**:", "**Actual Result**:"]
        }
      ],
      "fixture_stdout": null,
      "actual_result_stub": null,
      "expected_native_until_run": true
    },
